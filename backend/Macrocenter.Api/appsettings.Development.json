{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    // Used when you run the API directly (Visual Studio F5, or `dotnet run`)
    // instead of through Docker Compose. Postgres publishes 5432 to the host,
    // so `docker compose up -d db` is enough to make this work.
    // Compose overrides this with ConnectionStrings__DefaultConnection.
    "DefaultConnection": "Host=localhost;Port=5432;Database=macrocenter;Username=macrocenter;Password=macrocenter"
  },
  "Cors": {
    "AllowedOrigins": "http://localhost:3000"
  }
}
