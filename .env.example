# Copy to .env and adjust. Never commit .env.
#   Windows PowerShell: Copy-Item .env.example .env
#   macOS / Linux:      cp .env.example .env

# --- Postgres ---
POSTGRES_USER=macrocenter
POSTGRES_PASSWORD=macrocenter
POSTGRES_DB=macrocenter
POSTGRES_PORT=5432

# --- API ---
API_PORT=8080
ASPNETCORE_ENVIRONMENT=Development
# Signing key for the JWTs the API issues. Any long random string works for
# local development; this project is never deployed to production.
JWT_KEY=local-development-signing-key-change-me-at-least-32-chars
# Browser origins allowed to call the API (comma-separated).
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Frontend ---
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8080
API_URL=http://api:8080
